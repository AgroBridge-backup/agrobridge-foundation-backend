{
  "name": "agrobridge-foundation-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "contracts:openapi:export": "tsx contracts/scripts/export-openapi-snapshot.ts",
    "contracts:openapi:check": "tsx contracts/scripts/check-openapi-snapshot.ts",
    "test:contracts": "vitest run tests/contracts",
    "test:synthetic": "vitest run tests/contracts/synthetic-endpoints.test.ts",
    "contracts:check": "node scripts/contracts/preflight.mjs && npm run contracts:openapi:check && npm run test:contracts",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test": "npm run prisma:generate && vitest run --hookTimeout=180000 --testTimeout=180000 --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "test:unit": "npm run build && vitest run tests/unit",
    "test:integration": "npm run prisma:generate && node scripts/check-docker.mjs && vitest run tests/integration --hookTimeout=180000 --testTimeout=180000 --no-file-parallelism --maxWorkers=1",
    "test:e2e": "npm run prisma:generate && vitest run tests/e2e --hookTimeout=60000 --testTimeout=60000",
    "test:e2e:ui": "playwright test",
    "test:load": "k6 run load-tests/k6/scenarios/health.js",
    "test:tier1": "npm run lint && npm run test:unit",
    "test:tier2": "npm run test:integration",
    "test:tier3:chaos": "TEST_TIER3=1 vitest run tests/chaos tests/performance tests/unit/lru-cache-performance.test.ts",
    "test:tier3:benchmarks": "node scripts/check-docker.mjs && TEST_TIER3=1 vitest run tests/benchmarks/rate-limiting.bench.ts",
    "test:tier3:load": "node scripts/check-k6.mjs && npm run test:load && k6 run load-tests/k6/scenarios/spike.js && k6 run load-tests/k6/scenarios/soak.js",
    "test:tier3": "npm run test:tier3:chaos && npm run test:tier3:benchmarks && npm run test:tier3:load",
    "test:tier3:nightly": "npm run test:tier3:chaos && npm run test:tier3:benchmarks",
    "test:coverage": "node scripts/check-docker.mjs && vitest run --coverage",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:repo": "node scripts/check-repo-hygiene.mjs && node scripts/check-test-lifecycle.mjs",
    "lint": "npm run lint:eslint && npm run lint:repo",
    "knip": "knip",
    "report:release": "node scripts/generate-release-report.mjs artifacts/release/release-readiness.md",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.58.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.210.0",
    "@opentelemetry/sdk-node": "^0.210.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "@redis/client": "^1.5.14",
    "@testcontainers/postgresql": "^11.11.0",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.2",
    "dompurify": "^3.3.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.7.1",
    "fastify-raw-body": "^5.0.0",
    "jsdom": "^26.1.0",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "stripe": "^20.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^15.9.0",
    "knip": "^6.22.0",
    "prettier": "^3.3.3",
    "prisma": "^7.2.0",
    "testcontainers": "^11.11.0",
    "tinybench": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.17"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
