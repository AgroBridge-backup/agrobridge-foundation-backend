{
  "name": "agrobridge-foundation-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "npm run build && vitest run tests/unit",
    "test:integration": "node scripts/check-docker.mjs && vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:load": "k6 run load-tests/k6/scenarios/health.js",
    "test:coverage": "node scripts/check-docker.mjs && vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.58.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.210.0",
    "@opentelemetry/sdk-node": "^0.210.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "@redis/client": "^1.5.14",
    "@testcontainers/postgresql": "^11.11.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.7.1",
    "fastify-raw-body": "^5.0.0",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "stripe": "^20.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "prisma": "^7.2.0",
    "testcontainers": "^11.11.0",
    "tinybench": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.17"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
