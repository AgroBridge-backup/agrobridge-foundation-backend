import { describe, expect, it, beforeEach, vi } from 'vitest';

import { withDbSpan } from '../src/observability/db-span';
import { requestContext } from '../src/observability/request-context';

describe('withDbSpan slow logging', () => {
  beforeEach(() => {
    process.env.NODE_ENV = 'test';
    process.env.PORT = '3000';
    process.env.DATABASE_URL = 'postgresql://x:y@localhost:5432/z';
    process.env.JWT_SECRET = 'x'.repeat(32);
    process.env.COOKIE_SECRET = 'y'.repeat(16);
    process.env.STRIPE_SECRET_KEY = 'sk_test_x';
    process.env.STRIPE_WEBHOOK_SECRET = 'whsec_x';
    process.env.STRIPE_API_VERSION = '2024-06-20';
    process.env.CORS_ORIGIN = 'https://example.com';
    process.env.DB_SLOW_MS = '1';
  });

  it('logs via request-scoped pino logger when slow', async () => {
    const warn = vi.fn();
    requestContext.run({ warn } as any);

    await withDbSpan({
      name: 'db.test.op',
      model: 'Donation',
      operation: 'create',
      fn: async () => {
        // Ensure we cross the threshold deterministically.
        await new Promise((r) => setTimeout(r, 3));
        return 123;
      },
    });

    expect(warn).toHaveBeenCalledTimes(1);

    const [obj, msg] = warn.mock.calls[0];
    expect(msg).toBe('slow db operation');
    expect(obj).toMatchObject({
      span: 'db.test.op',
      model: 'Donation',
      operation: 'create',
      thresholdMs: 1,
    });

    expect(typeof obj.durationMs).toBe('number');
    expect(obj.durationMs).toBeGreaterThanOrEqual(1);
  });
});
