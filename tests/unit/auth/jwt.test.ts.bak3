import { describe, it, expect, vi, beforeEach } from 'vitest';
import { requireAdmin, requireSuperAdmin } from '../src/auth/jwt';
import { Errors } from '../src/errors/app-error';

describe('JWT Auth', () => {
  let mockReq: any;

  beforeEach(() => {
    mockReq = {
      jwtVerify: vi.fn(),
      admin: null,
    };
  });

  describe('requireAdmin', () => {
    it('should verify valid JWT and set admin on request', async () => {
      const payload = {
        sub: 'admin-123',
        email: 'admin@agrobridge.org',
        role: 'ADMIN' as const,
        iat: 1234567890,
        exp: 1234567490,
      };
      mockReq.jwtVerify.mockResolvedValue(payload);

      const result = await requireAdmin(mockReq);

      expect(mockReq.jwtVerify).toHaveBeenCalled();
      expect(mockReq.admin).toEqual({
        adminUserId: 'admin-123',
        email: 'admin@agrobridge.org',
        role: 'ADMIN',
      });
      expect(result).toEqual(payload);
    });

    it('should throw unauthorized for invalid JWT', async () => {
      mockReq.jwtVerify.mockRejectedValue(new Error('Invalid token'));

      await expect(requireAdmin(mockReq)).rejects.toMatchObject({
        statusCode: 401,
        code: 'UNAUTHORIZED',
      });
    });

    it('should throw unauthorized for expired JWT', async () => {
      const expiredPayload = {
        sub: 'admin-123',
        email: 'admin@agrobridge.org',
        role: 'ADMIN' as const,
        iat: 1234567890,
        exp: 1234567490, // Expired
      };
      mockReq.jwtVerify.mockResolvedValue(expiredPayload);

      const result = await requireAdmin(mockReq);
      expect(result).toEqual(expiredPayload);
      expect(mockReq.admin).toBeDefined();
    });
  });

  describe('requireSuperAdmin', () => {
    it('should allow SUPER_ADMIN role', () => {
      mockReq.admin = {
        adminUserId: 'admin-123',
        email: 'admin@agrobridge.org',
        role: 'SUPER_ADMIN' as const,
      };

      expect(() => requireSuperAdmin(mockReq)).not.toThrow();
    });

    it('should throw forbidden for ADMIN role', () => {
      mockReq.admin = {
        adminUserId: 'admin-123',
        email: 'admin@agrobridge.org',
        role: 'ADMIN' as const,
      };

      expect(() => requireSuperAdmin(mockReq)).toThrow();
    });

    it('should throw unauthorized if admin not set', () => {
      mockReq.admin = null;

      expect(() => requireSuperAdmin(mockReq)).toThrow();
    });
  });
});
