{
  "dashboard": {
    "title": "Rate Limiting - Production",
    "tags": ["rate-limiting", "production"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Rate Limit Checks (RPS)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(rate_limit_checks_total[5m])) by (tier, store_type)",
            "legendFormat": "{{tier}} - {{store_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "min": 0
          }
        }
      },
      {
        "id": 2,
        "title": "Allowed vs Rejected",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(rate_limit_checks_total[5m])) by (tier, allowed)",
            "legendFormat": "{{tier}} - {{allowed}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 0 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "P99 Latency",
        "type": "gauge",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(rate_limit_check_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0,
            "max": 0.01,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.005 },
                { "color": "red", "value": 0.01 }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "P50/P95/P99 Latency Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(rate_limit_check_duration_seconds_bucket[5m]))",
            "legendFormat": "P50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(rate_limit_check_duration_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(rate_limit_check_duration_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 5,
        "title": "Fallback Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(rate_limit_fallbacks_total[5m])",
            "legendFormat": "Fallbacks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Circuit Breaker State",
        "type": "stat",
        "targets": [
          {
            "expr": "rate_limit_circuit_breaker_open",
            "legendFormat": "Circuit Breaker Open"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 100,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 30 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Error Rate by Type",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(rate_limit_errors_total[5m]) by (error_type)",
            "legendFormat": "{{error_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Rejection Rate by Tier",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(rate_limit_checks_total{allowed=\"false\"}[5m])) by (tier) / sum(rate(rate_limit_checks_total[5m])) by (tier)",
            "legendFormat": "{{tier}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Memory Usage",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate_limit_memory_usage_bytes{instance=~\"rate-limiter.*\"} / 1024 / 1024",
            "legendFormat": "Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decmbytes",
            "min": 0,
            "max": 2000,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 500 },
                { "color": "red", "value": 1000 }
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "title": "Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "rate_limit_healthy",
            "legendFormat": "Healthy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": 1 },
                { "color": "red", "value": 0 }
              ]
            },
            "mappings": [
              {
                "options": { "0": { "text": "Unhealthy", "color": "red" } },
                "type": "value",
                "value": 0
              },
              {
                "options": { "1": { "text": "Healthy", "color": "green" } },
                "type": "value",
                "value": 1
              }
            ]
          }
        }
      }
    ]
  }
}
