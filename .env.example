# =============================================================================
# AGROBRIDGE FOUNDATION BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development                    # development | test | production
PORT=3000                               # Server port (1-65535)

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrobridge

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT secret for signing tokens (minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-characters-long

# Cookie signing secret (minimum 16 characters)
# Generate with: openssl rand -base64 24
COOKIE_SECRET=change-me-min-16-chars

# -----------------------------------------------------------------------------
# STRIPE PAYMENTS
# -----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2024-12-18.acacia

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,https://agrobridgefoundation.org

# -----------------------------------------------------------------------------
# REDIS (Caching & Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# OBSERVABILITY (Optional)
# -----------------------------------------------------------------------------
# OpenTelemetry collector endpoint for distributed tracing
# Example: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Enable OpenTelemetry diagnostic logging (1 to enable)
OTEL_DIAG=0

# Slow database query threshold in milliseconds (logs queries exceeding this)
# Recommended: 250 for production, 0 to disable
DB_SLOW_MS=250

# Database connection pool maximum size (default: 20)
# DB_POOL_MAX=20

# Database connection pool idle timeout in milliseconds (default: 20000)
# DB_POOL_IDLE_TIMEOUT=20000

# -----------------------------------------------------------------------------
# ABUSE DETECTION (Optional - ML Module)
# -----------------------------------------------------------------------------
# ABUSE_DETECTOR_CACHE_TTL=60000
# ABUSE_DETECTOR_MAX_CACHE_SIZE=10000
# ABUSE_DETECTOR_CLEANUP_INTERVAL_MS=30000
# ABUSE_DETECTOR_REPUTATION_SERVICE=http://ip-reputation:8080
# ABUSE_DETECTOR_GEOIP_SERVICE=http://geoip:8080
# ABUSE_DETECTOR_HIGH_RISK_COUNTRIES=

# -----------------------------------------------------------------------------
# SEEDING (Used by prisma/seed.ts)
# -----------------------------------------------------------------------------
# Initial admin user credentials for database seeding
ADMIN_EMAIL=admin@agrobridge.org
ADMIN_PASSWORD=change-me-secure-password
ADMIN_ROLE=SUPER_ADMIN
