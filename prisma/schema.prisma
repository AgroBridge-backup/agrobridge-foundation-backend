generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum DonationStatus {
  PENDING
  SUCCEEDED
  EXPIRED
  REFUNDED
  DISPUTED
  FAILED
}

enum DonationType {
  ONE_TIME
  RECURRING
}

enum ContactRequestStatus {
  NEW
  IN_REVIEW
  RESOLVED
  SPAM
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// =============================================================================
// CAMPAIGNS - Agricultural project funding campaigns
// =============================================================================

model Campaign {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(200)
  slug        String         @unique @db.VarChar(100)
  description String
  goalAmount  Int            // Target amount in minor units (cents)
  currency    String         @db.VarChar(3) @default("usd")
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  imageUrl    String?        @db.VarChar(500)
  metadata    Json?

  // Soft delete support
  deletedAt   DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  donations   Donation[]

  @@index([status])
  @@index([slug])
  @@index([status, startDate, endDate])
  @@index([deletedAt])
}

// =============================================================================
// DONATIONS - Payment records with campaign support
// =============================================================================

model Donation {
  id              String         @id @default(uuid()) @db.Uuid
  amount          Int            // Amount in minor units (cents)
  currency        String         @db.VarChar(3)
  status          DonationStatus @default(PENDING)
  type            DonationType   @default(ONE_TIME)
  stripeSessionId String?        @unique @db.VarChar(255)
  donorEmail      String?        @db.VarChar(254)
  donorName       String?        @db.VarChar(200)
  isAnonymous     Boolean        @default(false)
  message         String?        @db.VarChar(500) // Donor message/dedication
  metadata        Json?

  // Campaign association (optional - for general donations)
  campaignId      String?        @db.Uuid
  campaign        Campaign?      @relation(fields: [campaignId], references: [id])

  // Recurring donation support
  stripeSubscriptionId String?   @db.VarChar(255)

  // Soft delete support
  deletedAt       DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([donorEmail])
  @@index([donorEmail, createdAt])
  @@index([campaignId])
  @@index([campaignId, status])
  @@index([type])
  @@index([deletedAt])
}

// =============================================================================
// CONTACT REQUESTS - Contact form submissions
// =============================================================================

model ContactRequest {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(140)
  email     String               @db.VarChar(254)
  message   String
  status    ContactRequestStatus @default(NEW)

  // Admin notes for internal tracking
  adminNotes String?

  // Soft delete support
  deletedAt DateTime?

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([deletedAt])
}

// =============================================================================
// WEBHOOK EVENTS - Stripe event idempotency tracking
// =============================================================================

// Idempotency key is Stripe event.id
model WebhookEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(120)
  processed  Boolean  @default(false)
  rawPayload String
  createdAt  DateTime @default(now())

  @@index([processed, createdAt])
  @@index([type])
}

// =============================================================================
// ADMIN USERS - Administrative access
// =============================================================================

model AdminUser {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(254)
  passwordHash   String    @db.VarChar(255)
  role           AdminRole @default(ADMIN)
  firstName      String?   @db.VarChar(100)
  lastName       String?   @db.VarChar(100)
  lastLoginAt    DateTime?
  lastLoginIp    String?   @db.VarChar(45) // IPv6 max length
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  // Soft delete support
  deletedAt      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   @db.Uuid // Admin who created this user

  @@index([role])
  @@index([deletedAt])
  @@index([email, deletedAt])
}
